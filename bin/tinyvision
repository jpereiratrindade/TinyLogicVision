#!/usr/bin/env bash

# TinyLogicVision canonical application CLI v2.0

repo_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
build_dir="${TINYVISION_BUILD_DIR:-${repo_root}/build}"

print_usage() {
    cat <<'EOF'
TinyLogicVision CLI v2.0

Usage:
  tinyvision train DATASET_ROOT MODEL_PATH
  tinyvision classify MODEL_PATH IMAGE_PATH
  tinyvision evaluate MODEL_PATH SPLIT_DIRECTORY
  tinyvision map MODEL_PATH IMAGE_PATH OUTPUT_DIR [options]
  tinyvision workspace init PATH
  tinyvision web [--workspace PATH] [--port PORT] [--host HOST]
  tinyvision gui [WORKSPACE]
  tinyvision verify
  tinyvision --help | -h

Commands:
  train       Train model on DATASET_ROOT/train and observe DATASET_ROOT/dev
  classify    Classify a single PNG/JPEG image using a trained model
  evaluate    Evaluate a trained model on a labeled split directory (e.g. dev/ or probe/)
  map         Run dense spatial classification across an image grid
  workspace   Create or validate an isolated workspace
  web         Launch the local web GUI for a workspace on 127.0.0.1
  gui         Launch the Qt Quick workspace desktop
  verify      Run the complete project verification suite

Options:
  -h, --help  Show this help message
EOF
}


check_executable() {
    local target="$1"
    local hint="$2"
    if [ ! -x "${target}" ]; then
        printf 'tinyvision: executable not found or not executable: %s\n' "${target}" >&2
        if [ -n "${hint}" ]; then
            printf '%s\n' "${hint}" >&2
        fi
        return 1
    fi
    return 0
}

cmd="${1:-}"
if [ -z "${cmd}" ]; then
    print_usage >&2
    exit 2
fi

shift

case "${cmd}" in
    -h|--help|help)
        print_usage
        exit 0
        ;;
    train)
        target_bin="${build_dir}/tinyvision_train"
        if ! check_executable "${target_bin}" "Build the project first: cmake -S '${repo_root}' -B '${build_dir}' -G Ninja -DCMAKE_BUILD_TYPE=Release && cmake --build '${build_dir}'"; then
            exit 1
        fi
        if [ "$#" -ne 2 ]; then
            printf 'usage: tinyvision train DATASET_ROOT MODEL_PATH\n' >&2
            printf 'expected: DATASET_ROOT/train/CLASS/*.png and DATASET_ROOT/dev/CLASS/*.png\n' >&2
            exit 2
        fi
        exec "${target_bin}" "$@"
        ;;
    classify)
        target_bin="${build_dir}/tinyvision_classify"
        if ! check_executable "${target_bin}" "Build the project first: cmake -S '${repo_root}' -B '${build_dir}' -G Ninja -DCMAKE_BUILD_TYPE=Release && cmake --build '${build_dir}'"; then
            exit 1
        fi
        if [ "$#" -ne 2 ]; then
            printf 'usage: tinyvision classify MODEL_PATH IMAGE_PATH\n' >&2
            printf 'expected: MODEL_PATH (.tlv) and IMAGE_PATH (.png, .jpg, .jpeg)\n' >&2
            exit 2
        fi
        exec "${target_bin}" "$@"
        ;;
    evaluate)
        target_bin="${build_dir}/tinyvision_evaluate"
        if ! check_executable "${target_bin}" "Build the project first: cmake -S '${repo_root}' -B '${build_dir}' -G Ninja -DCMAKE_BUILD_TYPE=Release && cmake --build '${build_dir}'"; then
            exit 1
        fi
        if [ "$#" -ne 2 ]; then
            printf 'usage: tinyvision evaluate MODEL_PATH SPLIT_DIRECTORY\n' >&2
            printf 'expected: SPLIT_DIRECTORY/CLASS/*.png|*.jpg\n' >&2
            exit 2
        fi
        exec "${target_bin}" "$@"
        ;;
    map)
        target_bin="${build_dir}/tinyvision_map"
        if ! check_executable "${target_bin}" "Build the project first: cmake -S '${repo_root}' -B '${build_dir}' -G Ninja -DCMAKE_BUILD_TYPE=Release && cmake --build '${build_dir}'"; then
            exit 1
        fi
        if [ "$#" -lt 3 ]; then
            printf 'usage: tinyvision map MODEL_PATH IMAGE_PATH OUTPUT_DIR [options]\n' >&2
            printf 'options: --stride 1|2|4|8 --confidence FLOAT --margin FLOAT --sentinel-10m\n' >&2
            exit 2
        fi
        exec "${target_bin}" "$@"
        ;;
    web)

        server_script="${repo_root}/web/server.py"
        if [ ! -f "${server_script}" ]; then
            printf 'tinyvision: web server script not found: %s\n' "${server_script}" >&2
            exit 1
        fi
        exec python3 "${server_script}" "$@"
        ;;
    workspace)
        workspace_script="${repo_root}/web/workspace.py"
        if [ "${1:-}" != "init" ] || [ "$#" -ne 2 ]; then
            printf 'usage: tinyvision workspace init PATH\n' >&2
            exit 2
        fi
        exec python3 "${workspace_script}" "$@"
        ;;
    gui)
        target_bin="${build_dir}/tinyvision-gui"
        if ! check_executable "${target_bin}" "Build the Qt GUI first: cmake -S '${repo_root}' -B '${build_dir}' -G Ninja -DTINYVISION_BUILD_GUI=ON && cmake --build '${build_dir}' --target tinyvision-gui"; then
            exit 1
        fi
        if [ "$#" -gt 1 ]; then
            printf 'usage: tinyvision gui [WORKSPACE]\n' >&2
            exit 2
        fi
        if [ "$#" -eq 1 ]; then
            exec "${target_bin}" --workspace "$1"
        fi
        exec "${target_bin}"
        ;;
    verify)
        verify_script="${repo_root}/scripts/verify.sh"
        if ! check_executable "${verify_script}" ""; then
            exit 1
        fi
        exec "${verify_script}" "$@"
        ;;
    benchmark)
        target_bin="${build_dir}/tinyvision_benchmark"
        if ! check_executable "${target_bin}" "Build the project first: cmake -S '${repo_root}' -B '${build_dir}' -G Ninja -DCMAKE_BUILD_TYPE=Release && cmake --build '${build_dir}'"; then
            exit 1
        fi
        exec "${target_bin}" "$@"
        ;;
    *)
        printf 'tinyvision: unknown command: %s\n\n' "${cmd}" >&2
        print_usage >&2
        exit 2
        ;;
esac
